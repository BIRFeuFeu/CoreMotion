+/* ----- TOOLTIP (data-tip="...") ----- */
+[data-tip]{
+  position:relative;
+}
+[data-tip]::after{
+  content:attr(data-tip);
+  position:absolute;left:50%;bottom:calc(100% + 8px);
+  transform:translateX(-50%) translateY(4px);
+  background:#0f1623;color:#fff;font-size:12px;font-weight:600;
+  padding:6px 10px;border-radius:8px;white-space:nowrap;
+  opacity:0;pointer-events:none;
+  transition:opacity .15s var(--ease), transform .15s var(--ease);
+  box-shadow:0 6px 18px rgba(0,0,0,.25);
+  z-index:1000;
+}
+[data-tip]::before{
+  content:"";
+  position:absolute;left:50%;bottom:calc(100% + 2px);
+  transform:translateX(-50%);
+  border:6px solid transparent;border-top-color:#0f1623;
+  opacity:0;transition:opacity .15s var(--ease);
+  z-index:1000;
+}
+[data-tip]:hover::after,
+[data-tip]:focus-visible::after{opacity:1;transform:translateX(-50%) translateY(0);}
+[data-tip]:hover::before,
+[data-tip]:focus-visible::before{opacity:1;}
