+async function loadFeed(targetId, loaderKey, emptyKey){
+  const loader = document.querySelector(`[data-loader-${loaderKey}]`);
+  const empty = document.querySelector(`[data-empty-${loaderKey}]`);
+  const grid = document.getElementById(targetId);
+  if(!grid) return;
+  if(loader) loader.classList.remove("hidden");
+  if(empty) empty.classList.add("hidden");
+  showSkeleton(grid, 6, "4/3");
+  try{
+    const items = await dbGetUnifiedFeed({
+      mode: currentFeedMode,
+      userId: currentUser?.id
+    });
+    if(loader) loader.classList.add("hidden");
+    if(!items.length){
+      if(empty) empty.classList.remove("hidden");
+      grid.innerHTML = "";
+      return;
+    }
+    renderFeedCards(items, targetId);
+    grid.classList.remove("hidden");
+  }catch(err){
+    if(loader) loader.classList.add("hidden");
+    if(empty){
+      empty.textContent = "Erro ao carregar o feed: " + err.message;
+      empty.classList.remove("hidden");
+    }
+  }
+}
