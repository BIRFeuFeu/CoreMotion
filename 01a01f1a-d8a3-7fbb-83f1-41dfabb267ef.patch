+function renderFeedCards(items, targetId){
+  const grid = document.getElementById(targetId);
+  if(!grid) return;
+  if(!items.length){
+    grid.innerHTML = "";
+    return;
+  }
+  grid.innerHTML = items.map(it => {
+    if(it._type === "news"){
+      const author = (it.profiles && it.profiles.full_name) || "CoreMotion";
+      const initials = author.slice(0,1).toUpperCase();
+      const dateLabel = new Date(it.created_at).toLocaleDateString("pt-BR", { day:"2-digit", month:"short" });
+      const snippet = (it.content || "").slice(0, 110);
+      return `
+        <article class="feed-card" data-feed-type="news" data-feed-id="${it.id}" data-feed-ref-id="${it.id}">
+          <div class="feed-card-media" style="background-image:${safeBg("linear-gradient(135deg,#f5d76e,#c1121f)", it.image_url)};background-size:cover;background-position:center;">
+            <span class="feed-card-type">Notícia</span>
+          </div>
+          <div class="feed-card-body">
+            <div class="feed-card-author">
+              <div class="feed-card-author-avatar">${escapeHtml(initials)}</div>
+              <span>${escapeHtml(author)}</span>
+            </div>
+            <h3 class="feed-card-title">${escapeHtml(it.title)}</h3>
+            ${snippet ? `<p class="feed-card-snippet">${escapeHtml(snippet)}…</p>` : ""}
+            <span class="feed-card-time">${escapeHtml(dateLabel)}</span>
+          </div>
+        </article>`;
+    }
+    // media
+    const author = (it.profiles && it.profiles.full_name) || "Atleta";
+    const initials = author.slice(0,1).toUpperCase();
+    const caption = it.caption || "";
+    const hasMedia = !!it.url;
+    const isVideo = it.media_type === "video";
+    return `
+      <article class="feed-card" data-feed-type="media" data-feed-id="${it.id}" data-feed-ref-id="${it.id}">
+        <div class="feed-card-media" style="${hasMedia ? `background-image:url('${it.url}');background-size:cover;background-position:center;` : ""}">
+          ${hasMedia ? "" : `<span class="icon-inline" data-icon="film"></span>`}
+          <span class="feed-card-type">${isVideo ? "Vídeo" : "Foto"}</span>
+        </div>
+        <div class="feed-card-body">
+          <div class="feed-card-author">
+            <div class="feed-card-author-avatar">${escapeHtml(initials)}</div>
+            <span>${escapeHtml(author)}</span>
+          </div>
+          ${caption ? `<h3 class="feed-card-title">${escapeHtml(caption)}</h3>` : ""}
+          <span class="feed-card-time">${timeAgo(it.created_at)}</span>
+        </div>
+      </article>`;
+  }).join("");
+  renderIcons(grid);
+  // Click em card de mídia abre o detalhe da mídia
+  grid.querySelectorAll('[data-feed-type="media"]').forEach(card => {
+    card.addEventListener("click", () => switchView("midia"));
+  });
+  grid.querySelectorAll('[data-feed-type="news"]').forEach(card => {
+    card.addEventListener("click", () => switchView("noticias"));
+  });
+}
+
+function timeAgo(iso){
+  const d = new Date(iso);
+  const diff = (Date.now() - d.getTime()) / 1000;
+  if(diff < 60) return "agora";
+  if(diff < 3600) return Math.floor(diff/60) + "min";
+  if(diff < 86400) return Math.floor(diff/3600) + "h";
+  if(diff < 7*86400) return Math.floor(diff/86400) + "d";
+  return d.toLocaleDateString("pt-BR", { day:"2-digit", month:"short" });
+}
