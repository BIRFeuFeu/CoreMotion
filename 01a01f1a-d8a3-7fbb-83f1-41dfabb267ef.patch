+// ---- FEED UNIFICADO (mídia + notícias juntos, ordenados por data) ----
+async function dbGetUnifiedFeed(opts = {}){
+  const mode = opts.mode || "all"; // "all" | "media" | "news" | "following"
+  const limit = opts.limit || 30;
+
+  let media = [];
+  let news = [];
+
+  if(mode === "all" || mode === "media" || mode === "following"){
+    let q = sb.from("media")
+      .select("id, media_type, url, caption, created_at, user_id, profiles:user_id ( full_name, avatar_url )");
+    if(mode === "following" && opts.userId){
+      // Posts das pessoas que sigo: subquery em follows
+      const { data: follows } = await sb.from("follows").select("following_id").eq("follower_id", opts.userId);
+      const ids = (follows || []).map(f => f.following_id);
+      ids.push(opts.userId); // também inclui os próprios posts
+      q = q.in("user_id", ids.length ? ids : ["00000000-0000-0000-0000-000000000000"]);
+    }
+    const { data } = await q.order("created_at", { ascending: false }).limit(limit);
+    media = (data || []).map(m => ({ ...m, _type: "media" }));
+  }
+
+  if(mode === "all" || mode === "news"){
+    const { data } = await sb.from("news")
+      .select("id, title, content, category, image_url, created_at, author_id, profiles:author_id ( full_name, avatar_url )")
+      .order("created_at", { ascending: false })
+      .limit(limit);
+    news = (data || []).map(n => ({ ...n, _type: "news" }));
+  }
+
+  // Mescla por data
+  const merged = [...media, ...news].sort((a, b) =>
+    new Date(b.created_at) - new Date(a.created_at)
+  ).slice(0, limit);
+
+  return merged;
+}
+
+/* =========================================================
+   FASE 4 — AGENDA AVANÇADA + EQUIPES
+   Check-in por QR, avaliação pós-evento, métricas de equipe
+   ========================================================= */
+
+// ---- EVENTOS AVANÇADOS ----
+
+// Lista eventos com filtros: tipo, esporte, período (próximos/passados), team_id
+async function dbFilterEvents(filters = {}){
+  let q = sb.from("events").select("*");
+  if(filters.type && filters.type !== "all")      q = q.eq("type", filters.type);
+  if(filters.sport)                              q = q.eq("sport", filters.sport);
+  if(filters.team_id)                            q = q.eq("team_id", filters.team_id);
+  if(filters.onlyUpcoming)                       q = q.gte("event_date", new Date().toISOString());
+  if(filters.onlyPast)                           q = q.lt("event_date", new Date().toISOString());
+  // Ordenação: data do evento (próximos mais perto primeiro)
+  q = q.order("event_date", { ascending: !filters.onlyPast });
+  const { data, error } = await q;
+  if(error) throw error;
+  return data || [];
+}
+
+// Lista esportes distintos dos eventos (para popular filtro)
+async function dbGetEventSports(){
+  const { data, error } = await sb.from("events")
+    .select("sport").not("sport", "is", null);
+  if(error) throw error;
+  const set = new Set();
+  (data || []).forEach(r => { if(r.sport) set.add(r.sport); });
+  return [...set].sort();
+}
+
+// Inscreve o usuário em um evento E cria o registro de attendance com QR token
+async function dbEnrollEventWithQR(eventId, userId){
+  // Primeiro inscreve (se ainda não estiver)
+  const { data: existing } = await sb.from("event_enrollments")
+    .select("event_id").match({ event_id: eventId, user_id: userId }).maybeSingle();
+  if(!existing){
+    const { error: insErr } = await sb.from("event_enrollments")
+      .insert({ event_id: eventId, user_id: userId });
+    if(insErr) throw insErr;
+  }
+  // Cria o registro de attendance (com qr_token auto-gerado) — idempotente
+  const { data, error } = await sb.from("event_attendance")
+    .upsert({ event_id: eventId, user_id: userId }, { onConflict: "event_id,user_id", ignoreDuplicates: false })
+    .select("qr_token")
+    .single();
+  if(error) throw error;
+  return data?.qr_token || null;
+}
+
+// Pega o QR token do usuário para um evento (gera se não existir)
+async function dbGetMyEventQR(eventId, userId){
+  // Tenta pegar existente
+  const { data: existing } = await sb.from("event_attendance")
+    .select("qr_token, checked_in_at, rating").match({ event_id: eventId, user_id: userId })
+    .maybeSingle();
+  if(existing) return existing;
+  // Se não existir, inscreve + cria
+  return await dbEnrollEventWithQR(eventId, userId).then(token => ({
+    qr_token: token, checked_in_at: null, rating: null
+  }));
+}
+
+// Pega attendance completo do evento (quem se inscreveu, fez check-in, etc)
+async function dbGetEventAttendance(eventId){
+  const { data, error } = await sb.from("event_attendance")
+    .select("user_id, enrolled_at, checked_in_at, qr_token, rating, feedback, profiles:user_id ( full_name, avatar_url )")
+    .eq("event_id", eventId)
+    .order("enrolled_at", { ascending: true });
+  if(error) throw error;
+  return data || [];
+}
+
+// Faz check-in via QR token (via RPC atômica)
+async function dbCheckInEvent(qrToken){
+  const { data, error } = await sb.rpc("check_in_event", { p_qr_token: qrToken });
+  if(error) throw error;
+  return data;
+}
+
+// Usuário avalia o evento após participação (estrelas + feedback)
+async function dbRateEvent(eventId, userId, rating, feedback){
