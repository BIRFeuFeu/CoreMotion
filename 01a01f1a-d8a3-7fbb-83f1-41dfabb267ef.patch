+async function loadNotifications(){
+  const slot = document.getElementById("notif-lista");
+  if(!slot) return;
+  slot.innerHTML = `<p class="comment-empty">Carregando...</p>`;
+  try{
+    const items = await dbGetMyNotifications();
+    if(!items.length){
+      slot.innerHTML = `<p class="comment-empty">Nenhuma notificação ainda.</p>`;
+      return;
+    }
+    slot.innerHTML = items.map(n => {
+      const actor = (n.profiles && n.profiles.full_name) || "Alguém";
+      const initials = actor.slice(0,1).toUpperCase();
+      const unread = !n.read;
+      const message = notifMessage(n, actor);
+      return `
+        <div class="notif-item ${unread ? "unread" : ""}" data-notif-id="${n.id}" data-notif-read="${n.read}">
+          <div class="notif-avatar">${escapeHtml(initials)}</div>
+          <div class="notif-text">${message}<div class="notif-time">${timeAgo(n.created_at)}</div></div>
+        </div>`;
+    }).join("");
+    slot.querySelectorAll(".notif-item").forEach(it => {
+      it.addEventListener("click", async () => {
+        if(it.dataset.notifRead === "false"){
+          try{ await dbMarkNotificationRead(it.dataset.notifId); }catch{}
+          it.classList.remove("unread");
+          it.dataset.notifRead = "true";
+          refreshNotifBadge();
+        }
+      });
+    });
+  }catch(err){
+    slot.innerHTML = `<p class="comment-empty">Erro: ${escapeHtml(err.message)}</p>`;
+  }
+}
