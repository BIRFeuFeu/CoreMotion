+
+// Lista a galeria de imagens de um produto (ordenada)
+async function dbGetProductImages(productId){
+  const { data, error } = await sb
+    .from("product_images")
+    .select("id, url, position")
+    .eq("product_id", productId)
+    .order("position", { ascending: true });
+  if(error) throw error;
+  return data || [];
+}
+
+// Adiciona imagens à galeria de um produto (até 6 no total)
+async function dbAddProductImages(productId, urls){
+  if(!urls || !urls.length) return;
+  const rows = urls.map((url, i) => ({
+    product_id: productId,
+    url,
+    position: i
+  }));
+  const { error } = await sb.from("product_images").insert(rows);
+  if(error) throw error;
+}
+
+// Busca produtos com filtros avançados (categoria + preço + ordenação)
+async function dbFilterProducts(filters = {}){
+  let q = sb.from("products").select("*, profiles ( full_name )");
+  if(filters.category){
+    q = q.eq("category", filters.category);
+  }
+  if(filters.minPrice !== undefined && filters.minPrice !== null && filters.minPrice !== ""){
+    q = q.gte("price", parseFloat(filters.minPrice));
+  }
+  if(filters.maxPrice !== undefined && filters.maxPrice !== null && filters.maxPrice !== ""){
+    q = q.lte("price", parseFloat(filters.maxPrice));
+  }
+  const order = filters.order || "recent";
+  if(order === "price_asc")      q = q.order("price", { ascending: true });
+  else if(order === "price_desc") q = q.order("price", { ascending: false });
+  else                            q = q.order("created_at", { ascending: false });
+
+  const { data, error } = await q;
+  if(error) throw error;
+  return data || [];
+}
+
+// Lista as categorias distintas existentes (para popular o filtro)
+async function dbGetProductCategories(){
+  const { data, error } = await sb
+    .from("products")
+    .select("category")
+    .not("category", "is", null);
+  if(error) throw error;
+  const set = new Set();
+  (data || []).forEach(r => { if(r.category) set.add(r.category); });
+  return [...set].sort();
+}
+
