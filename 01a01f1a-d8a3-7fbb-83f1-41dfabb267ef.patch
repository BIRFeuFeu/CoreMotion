+  perform public.create_notification(
+    v_owner, 'rating', new.buyer_id,
+    jsonb_build_object('ref_id', new.product_id::text, 'ref_type', 'product', 'rating', new.rating)
+  );
+  return new;
+end;
+$$ language plpgsql;
