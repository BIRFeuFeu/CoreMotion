+function renderLineChart(canvasId, data, label, color){
+  const el = document.getElementById(canvasId);
+  if(!el || typeof Chart === "undefined") return;
+  const labels = data.map(d => d.date ? new Date(d.date).toLocaleDateString("pt-BR", { day:"2-digit", month:"short" }) : "");
+  const values = data.map(d => Number(d.count || 0));
+  paineChartInstances[canvasId] = new Chart(el, {
+    type: "line",
+    data: { labels, datasets: [{ label, data: values, borderColor: color, backgroundColor: color + "22", tension: 0.3, fill: true }]},
+    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }}}
+  });
+}
+
+function renderBarChart(canvasId, data, labelKey, valueKey, color){
+  const el = document.getElementById(canvasId);
+  if(!el || typeof Chart === "undefined") return;
+  paineChartInstances[canvasId] = new Chart(el, {
+    type: "bar",
+    data: { labels: data.map(d => d[labelKey]), datasets: [{ data: data.map(d => Number(d[valueKey] || 0)), backgroundColor: color }]},
+    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }}, indexAxis: canvasId === "chart-funnel" ? "y" : "x" }
+  });
+}
+
+function renderDoughnutChart(canvasId, data, label){
+  const el = document.getElementById(canvasId);
+  if(!el || typeof Chart === "undefined") return;
+  const colors = ["#e5383b","#2563eb","#f59e0b","#22c55e","#8b5cf6","#06b6d4"];
+  paineChartInstances[canvasId] = new Chart(el, {
+    type: "doughnut",
+    data: {
+      labels: data.map(d => d.status),
+      datasets: [{ data: data.map(d => Number(d.count || 0)), backgroundColor: data.map((_,i) => colors[i % colors.length]) }]
+    },
+    options: { responsive: true, maintainAspectRatio: false }
+  });
+}
