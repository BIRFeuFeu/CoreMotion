+// Listeners dos filtros do feed (Tudo / Seguindo / Mídia / Notícias)
+document.querySelectorAll(".feed-filter").forEach(btn => {
+  btn.addEventListener("click", () => {
+    const mode = btn.dataset.feedMode;
+    const target = btn.dataset.feedTarget || "feed-grid";
+    document.querySelectorAll(`.feed-filter[data-feed-mode]`).forEach(b => {
+      if(b.dataset.feedTarget === target || (!b.dataset.feedTarget && target === "feed-grid")){
+        b.classList.toggle("active", b.dataset.feedMode === mode);
+      }
+    });
+    currentFeedMode = mode;
+    const loaderKey = target === "feed-grid" ? "feed" : "feed-2";
+    loadFeed(target, loaderKey, loaderKey);
+  });
+});
