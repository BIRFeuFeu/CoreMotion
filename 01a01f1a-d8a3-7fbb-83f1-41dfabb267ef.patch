+/* =========================================================
+   FASE 5 — ANALYTICS & MODERAÇÃO AVANÇADA
+   Audit log, suspensão, gráficos, reports
+   ========================================================= */
+
+// ---- AUDIT LOG ----
+async function dbGetAuditLog(limit = 50){
+  const { data, error } = await sb.from("audit_log")
+    .select("id, actor_id, action, target_type, target_id, details, created_at, profiles:actor_id ( full_name )")
+    .order("created_at", { ascending: false })
+    .limit(limit);
+  if(error) throw error;
+  return data || [];
+}
+
+// ---- SUSPENSÃO ----
+async function dbSuspendUser(targetId, days, reason){
+  const { data, error } = await sb.rpc("suspend_user", { p_target: targetId, p_days: days, p_reason: reason || null });
+  if(error) throw error;
+  return data;
+}
+async function dbUnsuspendUser(targetId){
+  const { data, error } = await sb.rpc("unsuspend_user", { p_target: targetId });
+  if(error) throw error;
+  return data;
+}
+async function dbGetAllUsersWithStatus(){
+  const { data, error } = await sb.rpc("get_all_users");
+  if(error) throw error;
+  // Acrescenta campo suspended (calculado no cliente com base em suspended_until)
+  return (data || []).map(u => ({
+    ...u,
+    suspended: u.suspended_until ? new Date(u.suspended_until) > new Date() : false,
+    suspended_until: u.suspended_until
+  }));
+}
+
+// ---- REPORTS (moderação) ----
+async function dbResolveReport(id, status){
+  const { error } = await sb.from("reports")
+    .update({ status, resolved_by: null, resolved_at: new Date().toISOString() })
+    .eq("id", id);
+  if(error) throw error;
+}
+
+// ---- ANALYTICS (para gráficos do Painel do Dono) ----
+async function dbGetAnalytics(){
+  const { data, error } = await sb.rpc("get_analytics");
+  if(error) throw error;
+  return data || {};
+}
