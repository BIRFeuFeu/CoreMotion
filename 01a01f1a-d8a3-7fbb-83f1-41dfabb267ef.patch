+  let rects = "";
+  // Quadrados de "position" (3 corners) — visivelmente parece QR
+  const corners = [[0,0],[cells-7,0],[0,cells-7]];
+  corners.forEach(([x,y]) => {
+    rects += `<rect x="${x*cellSize}" y="${y*cellSize}" width="${7*cellSize}" height="${7*cellSize}" fill="#111"/>`;
+    rects += `<rect x="${(x+1)*cellSize}" y="${(y+1)*cellSize}" width="${5*cellSize}" height="${5*cellSize}" fill="#fff"/>`;
+    rects += `<rect x="${(x+2)*cellSize}" y="${(y+2)*cellSize}" width="${3*cellSize}" height="${3*cellSize}" fill="#111"/>`;
+  });
+  // Preenche o resto com padrão determinístico do token
+  for(let y = 0; y < cells; y++){
+    for(let x = 0; x < cells; x++){
+      const skip = corners.some(([cx,cy]) => x >= cx && x < cx + 7 && y >= cy && y < cy + 7);
+      if(skip) continue;
+      // hash simples do par (x,y) com o token
+      const idx = (y * cells + x) % s.length;
+      const ch = s.charCodeAt(idx);
+      if((ch + x * 7 + y * 13) % 3 === 0){
+        rects += `<rect x="${x*cellSize}" y="${y*cellSize}" width="${cellSize}" height="${cellSize}" fill="#111"/>`;
+      }
+    }
+  }
+  return `<svg viewBox="0 0 ${size} ${size}" xmlns="http://www.w3.org/2000/svg" style="width:${size}px;height:${size}px;display:block">
+    <rect width="${size}" height="${size}" fill="#fff"/>
+    ${rects}
+    <text x="${size/2}" y="${size - 6}" text-anchor="middle" font-size="9" fill="#666" font-family="monospace">${token.slice(0,8)}</text>
+  </svg>`;
+}
