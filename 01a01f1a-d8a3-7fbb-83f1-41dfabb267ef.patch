+function notifMessage(n, actor){
+  const type = n.type;
+  if(type === "follow")   return `<strong>${escapeHtml(actor)}</strong> começou a seguir você.`;
+  if(type === "like")     return `<strong>${escapeHtml(actor)}</strong> curtiu sua mídia.`;
+  if(type === "comment")  return `<strong>${escapeHtml(actor)}</strong> comentou no seu produto.`;
+  if(type === "rating")   return `<strong>${escapeHtml(actor)}</strong> avaliou seu produto.`;
+  if(type === "order")    return `Seu pedido foi atualizado.`;
+  if(type === "event")    return `Há um novo evento disponível.`;
+  if(type === "system")   return `Mensagem do CoreMotion.`;
+  return `<strong>${escapeHtml(actor)}</strong> fez algo.`;
+}
