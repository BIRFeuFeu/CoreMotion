+// Resumo agregado (média + contagem) — usado em cards de produto
+async function dbGetProductRatingSummary(productId){
+  const { data, error } = await sb
+    .from("product_ratings")
+    .select("rating")
+    .eq("product_id", productId);
+  if(error) throw error;
+  const arr = data || [];
+  if(!arr.length) return { avg: null, count: 0 };
+  const sum = arr.reduce((s, r) => s + r.rating, 0);
+  return { avg: sum / arr.length, count: arr.length };
+}
